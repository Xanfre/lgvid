LDOPTS = -Wl,--nxcompat -Wl,--no-seh -Wl,--dynamicbase lgvid.def

all: lgvid.dll

lgvid.o: lgvid.cpp
	$(CC) -I. $(CFLAGS) $(CPPFLAGS) -c $(CC_O) $<

lgvid.dll: lgvid.o $(INNER_LIBS)
	$(LD) -shared -o $@ $(LDOPTS) lgvid.o $(INNER_LIBS) $(EXTRALIBS)
