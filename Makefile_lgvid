include config.mak

INNER_LIBS = libavformat/libavformat.a libavcodec/libavcodec.a libavutil/libavutil.a libswscale/libswscale.a

EXTRALIBS = -ffast-math -lws2_32 -lvfw32 -liconv -lfribidi -lenca -lz -lbz2 -lmad -lspeex -LH:/MinGW/lib -ltheora -logg -la52 -ldca -lfaad -ladvapi32 -lole32 -lstdc++ -lopencore-amrnb -lopencore-amrwb -lxvidcore -lm -lvpx -L/mingw/lib -static

LDOPTS = -Wl,--nxcompat -Wl,--no-seh -Wl,--dynamicbase lgvid.def

all: lgvid.dll

lgvid.o: lgvid.cpp
	$(CC) -I. $(CFLAGS) $(CPPFLAGS) -c $(CC_O) $<

lgvid.dll: lgvid.o $(INNER_LIBS)
	gcc -shared -o $@ $(LDOPTS) lgvid.o $(INNER_LIBS) $(EXTRALIBS)
