ifeq ($(USE_FFMPEG_44),)
include config.mak
else
include ffbuild/config.mak
endif

INNER_LIBS = libavformat/libavformat.a libavcodec/libavcodec.a libavutil/libavutil.a libswscale/libswscale.a
ifneq ($(USE_FFMPEG_44),)
	INNER_LIBS += libswresample/libswresample.a
endif

