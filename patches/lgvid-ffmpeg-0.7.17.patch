+      __asm__( ".align 4\n\t" \
+               ".globl " ASM_NAME(#name) "\n\t" \
+               ".type " ASM_NAME(#name) ",@function\n" \
+               ASM_NAME(#name) ":\n\t" \
+               code );
+#else  /* __GNUC__ */
+# define ASM_GLOBAL_FUNC(name,code) \
+      void asm_dummy_##name(void) { \
+          __asm__( ".align 4\n\t" \
+               ".globl " ASM_NAME(#name) "\n\t" \
+               ".type " ASM_NAME(#name) ",@function\n" \
+               ASM_NAME(#name) ":\n\t" \
+               code ); \
+      }
+#endif  /* __GNUC__ */
