+    DMO_OUTPUT_DATA_BUFFERF_TIME	= 0x2,
+    DMO_OUTPUT_DATA_BUFFERF_TIMELENGTH	= 0x4,
+    DMO_OUTPUT_DATA_BUFFERF_INCOMPLETE	= 0x1000000
+};
+
+enum DMO_INPUT_STATUS_FLAGS
+{
