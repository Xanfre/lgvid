+static long WINAPI expQueryPerformanceFrequency(long long* z)
+{
+    *z=(long long)CPU_Freq();
+    dbgprintf("QueryPerformanceFrequency(0x%x) => 1 ( %Ld )\n", z, *z);
+    return 1;
+}
