+++ ffmpeg-0.7.17-lgvid/loader/dshow/cmediasample.h	2023-03-26 22:20:20.589023128 -0500
@@ -0,0 +1,32 @@
+#ifndef MPLAYER_CMEDIASAMPLE_H
+#define MPLAYER_CMEDIASAMPLE_H
+
+#include "interfaces.h"
+#include "guids.h"
+
+typedef struct CMediaSample CMediaSample;
+struct CMediaSample
+{
+    IMediaSample_vt* vt;
+    DECLARE_IUNKNOWN();
+    IMemAllocator* all;
+    int size;
+    int actual_size;
+    char* block;
+    char* own_block;
+    int isPreroll;
+    int isSyncPoint;
+    int isDiscontinuity;
+    LONGLONG time_start;
