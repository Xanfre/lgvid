diff -Nur ffmpeg-0.7.17/libavcodec/indeo4.c ffmpeg-0.7.17-lgvid/libavcodec/indeo4.c
--- ffmpeg-0.7.17/libavcodec/indeo4.c	1969-12-31 18:00:00.000000000 -0600
+++ ffmpeg-0.7.17-lgvid/libavcodec/indeo4.c	2023-03-28 04:56:33.308805302 -0500
@@ -0,0 +1,231 @@
+/*
+ * Intel Indeo 4.1 (IV41) video decoder dll interface for ffmpeg
+ * written, produced, and directed by Alan Smithee
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavutil/imgutils.h"
+#include "avcodec.h"
+#include "bytestream.h"
+#include "loader/wine/driver.h"
+#include "loader/wine/vfw.h"
+
+typedef struct Indeo4DecodeContext {
+    AVCodecContext *avctx;
+    int width, height;
+    AVFrame frame;
+
+	int rowbytes;
+	uint8_t *buffer;
+
+    BITMAPINFOHEADER bih;
+    BITMAPINFOHEADER *o_bih;
+
+    HIC vfw_handle;
+} Indeo4DecodeContext;
+
+
+static av_cold void iv4_free_func(Indeo4DecodeContext *s)
+{
+	av_free(s->buffer);
+    av_free(&s->o_bih);
+}
+
+static av_cold int indeo_decode_init(AVCodecContext *avctx, const char *dllname, uint32_t compression)
+{
+    Indeo4DecodeContext *s = avctx->priv_data;
+    int ret = 0;
+    int o_bih_len;
+
+    s->avctx = avctx;
+    s->width = avctx->width;
+    s->height = avctx->height;
+
+	memset(&s->bih, 0, sizeof(s->bih));
+	s->bih.biSize = sizeof(s->bih);
+    s->bih.biWidth = avctx->coded_width;
+    s->bih.biHeight = avctx->coded_height;
+    s->bih.biPlanes = 1;
+    s->bih.biBitCount = avctx->bits_per_coded_sample;
+    s->bih.biCompression = compression;
+    s->bih.biSizeImage = s->bih.biWidth * s->bih.biHeight * ((s->bih.biBitCount + 7) / 8);
+
+    s->vfw_handle = ICOpen((long)dllname, s->bih.biCompression, ICMODE_DECOMPRESS);
+    if(!s->vfw_handle) {
+		av_log(s->avctx, AV_LOG_ERROR, "ICOpen failed! unknown codec / wrong parameters?\n");
+		return -1;
+	}
+
+    o_bih_len = ICDecompressGetFormatSize(s->vfw_handle, &s->bih);
+    if(o_bih_len < sizeof(BITMAPINFOHEADER)) {
+    	av_log(s->avctx, AV_LOG_ERROR, "ICDecompressGetFormatSize returned a bogus value: %d\n", o_bih_len);
+    	return -1;
+    }
+
+    s->o_bih = av_malloc(o_bih_len);
+    memset(s->o_bih, 0, o_bih_len);
+
+    ret = ICDecompressGetFormat(s->vfw_handle, &s->bih, s->o_bih);
+    if(ret < 0) {
+		av_log(s->avctx, AV_LOG_ERROR, "ICDecompressGetFormat failed: Error %d\n", (int)ret);
+		return -1;
+    }
+
+	s->o_bih->biHeight = -s->bih.biHeight; // flip image!
+
+	// we want 24-bit RGB image out from the decoder
+    avctx->pix_fmt = PIX_FMT_BGR24;
+    s->o_bih->biBitCount = 24;
+
+	// alloc temp buffer supplied to decoder since VfW apparently cannot deal with strided rows
+	s->rowbytes = abs(s->o_bih->biWidth) * ((s->o_bih->biBitCount + 7) / 8);
+	s->buffer = av_malloc(s->rowbytes * abs(s->o_bih->biHeight));
+
+	ret = ICDecompressQuery(s->vfw_handle, &s->bih, s->o_bih);
+    if (ret)
+		av_log(s->avctx, AV_LOG_ERROR, "ICDecompressQuery failed: Error %d\n", (int)ret);
+
+	ret = ICDecompressBegin(s->vfw_handle, &s->bih, s->o_bih);
+    if (ret)
+		av_log(s->avctx, AV_LOG_ERROR, "ICDecompressBegin failed: Error %d\n", (int)ret);
+
+    return 0;
+}
+
+static av_cold int indeo4_decode_init(AVCodecContext *avctx)
+{
+	return indeo_decode_init(avctx, "ir41_32.dll", mmioFOURCC('I','V','4','1'));
+}
+
+static int indeo4_decode_frame(AVCodecContext *avctx, void *data, int *data_size, AVPacket *avpkt)
+{
+    int ret;
+    /*const*/ uint8_t *buf = avpkt->data;
+    int buf_size = avpkt->size;
+    Indeo4DecodeContext *s = avctx->priv_data;
+
+    /*// set stride:  (trick discovered by Andreas Ackermann - thanx!)
+    s->bih.width=avctxt->coded_width; //mpi->stride[0]/(mpi->bpp/8);
+    s->o_bih->biWidth=avctxt->coded_width; //mpi->stride[0]/(mpi->bpp/8);*/
+
+	s->bih.biSizeImage = buf_size;
+
+    if(s->frame.data[0])
+        avctx->release_buffer(avctx, &s->frame);
+
+    s->frame.reference = 0;
+    if(avctx->get_buffer(avctx, &s->frame) < 0) {
+        av_log(s->avctx, AV_LOG_ERROR, "get_buffer() failed\n");
+        return -1;
+    }
+
+    ret = ICDecompress(s->vfw_handle,
+		((avpkt->flags&AV_PKT_FLAG_KEY)?0:ICDECOMPRESS_NOTKEYFRAME) |
+			((avctx->hurry_up>0)?(ICDECOMPRESS_HURRYUP|ICDECOMPRESS_PREROL):0),
+		&s->bih, (void*)buf, s->o_bih, (void*)s->buffer);
+
+    if (ret) {
+    	av_log(s->avctx, AV_LOG_WARNING, "Error decompressing frame, err=%d\n", ret);
+    	return -1;
+    }
+
+	// copy from temp buffer to strided frame buffer
+	{
+    int y;
+    uint8_t *src = s->buffer;
+    uint8_t *dest = s->frame.data[0];
+
+    for (y = 0; y < s->height; y++) {
+        memcpy(dest, src, s->rowbytes);
+        src += s->rowbytes;
+        dest += s->frame.linesize[0];
+    }
+	}
+
+    *data_size = sizeof(AVFrame);
+    *(AVFrame*)data = s->frame;
+
+    return buf_size;
+}
+
+static av_cold int indeo4_decode_close(AVCodecContext *avctx)
+{
+    Indeo4DecodeContext *s = avctx->priv_data;
+    int ret;
+
+    ret = ICDecompressEnd(s->vfw_handle);
+    if (ret)
+		av_log(s->avctx, AV_LOG_ERROR, "ICDecompressEnd failed: %d\n", ret);
+
+    ret = ICClose(s->vfw_handle);
+    if (ret)
+		av_log(s->avctx, AV_LOG_ERROR, "ICClose failed: %d\n", ret);
+
+    if(s->frame.data[0])
+        avctx->release_buffer(avctx, &s->frame);
+
+    iv4_free_func(s);
+
+    return 0;
+}
+
+AVCodec ff_indeo4_decoder = {
+    .name           = "indeo4",
+    .type           = AVMEDIA_TYPE_VIDEO,
+    .id             = CODEC_ID_INDEO4,
+    .priv_data_size = sizeof(Indeo4DecodeContext),
+    .init           = indeo4_decode_init,
+    .close          = indeo4_decode_close,
+    .decode         = indeo4_decode_frame,
+    .long_name      = NULL_IF_CONFIG_SMALL("Intel Indeo 4.1"),
+};
+
+
+
+/* for good measure we also supply ir50_32.dll support here */
+
+static av_cold int indeo5_decode_init(AVCodecContext *avctx)
+{
+	return indeo_decode_init(avctx, "ir50_32.dll", mmioFOURCC('I','V','5','0'));
+}
+
+AVCodec ff_indeo5dll_decoder = {
+    .name           = "indeo5",
+    .type           = AVMEDIA_TYPE_VIDEO,
+    .id             = CODEC_ID_INDEO5,
+    .priv_data_size = sizeof(Indeo4DecodeContext),
+    .init           = indeo5_decode_init,
+    .close          = indeo4_decode_close,
+    .decode         = indeo4_decode_frame,
+    .long_name      = NULL_IF_CONFIG_SMALL("Intel Indeo Video Interactive 5"),
+};
+
+
+// yes this is ugly, but I'm too lazy to update make scripts stuff
+#undef malloc
+#undef free
+#undef printf
+#define malloc av_malloc
+#define free av_free
+#define printf(...)
+#include "loader/vfl.c"
+#include "loader/drv.c"
diff -Nur ffmpeg-0.7.17/libavcodec/ivi_dsp.c ffmpeg-0.7.17-lgvid/libavcodec/ivi_dsp.c
--- ffmpeg-0.7.17/libavcodec/ivi_dsp.c	2015-03-11 19:05:24.000000000 -0500
+++ ffmpeg-0.7.17-lgvid/libavcodec/ivi_dsp.c	2023-03-28 04:58:43.922799116 -0500
@@ -84,6 +84,10 @@
         }
 
         for (x = 0, indx = 0; x < plane->width; x+=2, indx++) {
+            // BUG FIX: this is the same issue as the buf fix below with 'pitch' except here it reads one pixel
+            //          to the right outside the band buffer for indx+1, so for the last loop indx+1 is indx
+            const int32_t right_idx = (x<plane->width-2) ? indx+1 : indx;
+
             /* some values calculated in the previous iterations can */
             /* be reused in the next ones, so do appropriate copying */
             b2_1 = b2_2; // b2[x-1,y  ] = b2[x,  y  ]
@@ -103,8 +107,8 @@
             if (num_bands > 0) {
                 tmp0 = b0_1;
                 tmp2 = b0_2;
-                b0_1 = b0_ptr[indx+1];
-                b0_2 = b0_ptr[pitch+indx+1];
+                b0_1 = b0_ptr[right_idx];
+                b0_2 = b0_ptr[pitch+right_idx];
                 tmp1 = tmp0 + b0_1;
 
                 p0 =  tmp0 << 4;
@@ -117,11 +121,11 @@
             if (num_bands > 1) {
                 tmp0 = b1_2;
                 tmp1 = b1_1;
-                b1_2 = b1_ptr[indx+1];
-                b1_1 = b1_ptr[back_pitch+indx+1];
+                b1_2 = b1_ptr[right_idx];
+                b1_1 = b1_ptr[back_pitch+right_idx];
 
                 tmp2 = tmp1 - tmp0*6 + b1_3;
-                b1_3 = b1_1 - b1_2*6 + b1_ptr[pitch+indx+1];
+                b1_3 = b1_1 - b1_2*6 + b1_ptr[pitch+right_idx];
 
                 p0 += (tmp0 + tmp1) << 3;
                 p1 += (tmp0 + tmp1 + b1_1 + b1_2) << 2;
@@ -131,8 +135,8 @@
 
             /* process the LH-band by applying LPF vertically and HPF horizontally */
             if (num_bands > 2) {
-                b2_3 = b2_ptr[indx+1];
-                b2_6 = b2_ptr[pitch+indx+1];
+                b2_3 = b2_ptr[right_idx];
+                b2_6 = b2_ptr[pitch+right_idx];
 
                 tmp0 = b2_1 + b2_2;
                 tmp1 = b2_1 - b2_2*6 + b2_3;
@@ -145,14 +149,14 @@
 
             /* process the HH-band by applying HPF both vertically and horizontally */
             if (num_bands > 3) {
-                b3_6 = b3_ptr[indx+1];            // b3[x+1,y  ]
-                b3_3 = b3_ptr[back_pitch+indx+1]; // b3[x+1,y-1]
+                b3_6 = b3_ptr[right_idx];            // b3[x+1,y  ]
+                b3_3 = b3_ptr[back_pitch+right_idx]; // b3[x+1,y-1]
 
                 tmp0 = b3_1 + b3_4;
                 tmp1 = b3_2 + b3_5;
                 tmp2 = b3_3 + b3_6;
 
-                b3_9 = b3_3 - b3_6*6 + b3_ptr[pitch+indx+1];
+                b3_9 = b3_3 - b3_6*6 + b3_ptr[pitch+right_idx];
 
                 p0 += (tmp0 + tmp1) << 2;
                 p1 += (tmp0 - tmp1*6 + tmp2) << 1;
@@ -175,6 +179,14 @@
         b1_ptr += pitch;
         b2_ptr += pitch;
         b3_ptr += pitch;
+
+        // BUG FIX: all code that accesses band buffers one row below (y+1) like b3_ptr[pitch+indx+1] will
+        //          on the last row, since band buffers are half the resolution of plane->height, access
+        //          data outside the buffer (which can crash) AND it caused the bug where the last pixel
+        //          row displayed random noise pixels.
+        //          for the last line y+1 should still be y, so we set pitch to 0 (like a reversed 'back_pitch')
+        if (y >= plane->height-4)
+            pitch = 0;
     }
 }
 
