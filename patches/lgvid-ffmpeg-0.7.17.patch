+
+
+enum DMO_INPUT_DATA_BUFFER_FLAGS
+{
+    DMO_INPUT_DATA_BUFFERF_SYNCPOINT	= 0x1,
+    DMO_INPUT_DATA_BUFFERF_TIME		= 0x2,
+    DMO_INPUT_DATA_BUFFERF_TIMELENGTH	= 0x4
+};
+
+enum DMO_OUTPUT_DATA_BUFFER_FLAGS
+{
