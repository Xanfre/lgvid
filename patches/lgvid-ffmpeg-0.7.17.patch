+static const char * WINAPI expPathFindFileNameA(const char *path) {
+  const char *name;
+  if (!path || strlen(path) < 2)
+    name = path;
+  else {
+    name = strrchr(path - 1, '\\');
+    if (!name)
+      name = path;
+  }
+  dbgprintf("PathFindFileNameA(0x%x = %s) => 0x%x, %s\n", path, path, name, name);
+  return name;
+}
