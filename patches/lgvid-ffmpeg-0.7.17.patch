+/*
+ * Returns the number of milliseconds, modulo 2^32, since the start
+ * of the wineserver.
+ */
+static int WINAPI expGetTickCount(void)
+{
+    static int tcstart = 0;
+    struct timeval t;
+    int tc;
+    gettimeofday( &t, NULL );
+    tc = ((t.tv_sec * 1000) + (t.tv_usec / 1000)) - tcstart;
+    if (tcstart == 0)
+    {
+	tcstart = 0;
+        tc = 0;
+    }
+    dbgprintf("GetTickCount() => %d\n", tc);
+    return tc;
+}
