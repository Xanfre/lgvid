+
+/**********************************************************************
+ *	    PE_LoadResource32
+ */
+HANDLE PE_LoadResource( WINE_MODREF *wm, HANDLE hRsrc )
+{
+    if (!hRsrc || !wm || wm->type!=MODULE32_PE)
+    	return 0;
+    return (HANDLE) (wm->module + ((PIMAGE_RESOURCE_DATA_ENTRY)hRsrc)->OffsetToData);
