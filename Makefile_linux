.PHONY: all clean

CXX ?= g++

SONAME ?= liblgvid.so.1

CXXFLAGS_ALL = -O2 -fPIC -fvisibility=hidden $(CXXFLAGS)
CPPFLAGS_ALL = -std=gnu++11 -Wall -Wextra -DSHIP -DUSE_STD_THREAD -include comcompat.h $(CPPFLAGS)
LDFLAGS_ALL = -Wl,--no-undefined -shared -Wl,--strip-all -Wl,-soname,$(SONAME) $(LDFLAGS)

LIBS = -lavformat -lavcodec -lavutil -lswscale -lswresample

ifneq ($(STATIC),)
	LIBS += $(EXTRA_LIBS) -static
endif

all: $(SONAME)

clean:
	rm -f lgvid.o $(SONAME)

lgvid.o: lgvid.cpp
	$(CXX) $(CXXFLAGS_ALL) $(CPPFLAGS_ALL) -c -o $@ $<

$(SONAME): lgvid.o
	$(CXX) $(CXXFLAGS_ALL) $(LDFLAGS_ALL) $^ -o $@ $(LIBS)
